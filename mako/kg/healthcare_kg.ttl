kg:refersTo a rdf:Property ;
    rdfs:comment "Refer the patient to a different specialty for dedicated assessment or follow-up that lies outside the current agent's domain (requires_specialist). Ownership moves to the receiving specialty." ;
    rdfs:subPropertyOf kg:canHandoffTo .

kg:returnsTo a rdf:Property ;
    rdfs:comment "Return the case to the referring or primary agent once a consult or specialist step is finished (consult_complete / treatment_complete), so the originating agent can resume coordination." ;
    rdfs:subPropertyOf kg:canHandoffTo .

kg:task_AnnualPhysicalExamPathway a kg:TaskType ;
    rdfs:label "AnnualPhysicalExamPathway" ;
    kg:requires [ kg:capability kg:cap_AssessPatientCondition ],
        [ kg:capability kg:cap_ConductScreening ],
        [ kg:capability kg:cap_RegisterPatient ],
        [ kg:capability kg:cap_EducatePatient ] .

kg:task_CancerScreeningPathway a kg:TaskType ;
    rdfs:label "CancerScreeningPathway" ;
    kg:requires [ kg:capability kg:cap_ManageChemotherapy ],
        [ kg:capability kg:cap_ConductFollowUp ],
        [ kg:capability kg:cap_AssessCancerStage ],
        [ kg:capability kg:cap_ReviewBiopsy ],
        [ kg:capability kg:cap_PlanOncologyTreatment ],
        [ kg:capability kg:cap_ConductScreening ] .

kg:task_ChestPainWorkup a kg:TaskType ;
    rdfs:label "ChestPainWorkup" ;
    kg:requires [ kg:capability kg:cap_ConductFollowUp ],
        [ kg:capability kg:cap_PlanCardiacTreatment ],
        [ kg:capability kg:cap_InterpretECG ],
        [ kg:capability kg:cap_InterpretEcho ],
        [ kg:capability kg:cap_AssessChestPain ],
        [ kg:capability kg:cap_AssessPatientCondition ] .

kg:task_DepressionScreeningPathway a kg:TaskType ;
    rdfs:label "DepressionScreeningPathway" ;
    kg:requires [ kg:capability kg:cap_ConductFollowUp ],
        [ kg:capability kg:cap_ManageMedication ],
        [ kg:capability kg:cap_CoordinateTherapy ],
        [ kg:capability kg:cap_ConductDiagnosticEval ],
        [ kg:capability kg:cap_AssessRisk ],
        [ kg:capability kg:cap_AssessPatientCondition ] .

kg:task_DiabetesManagementPathway a kg:TaskType ;
    rdfs:label "DiabetesManagementPathway" ;
    kg:requires [ kg:capability kg:cap_ReconcileMedications ],
        [ kg:capability kg:cap_ManageChronicCondition ],
        [ kg:capability kg:cap_AnalyzeSpecimen ],
        [ kg:capability kg:cap_EducatePatient ],
        [ kg:capability kg:cap_ConductFollowUp ] .

kg:task_FractureManagementPathway a kg:TaskType ;
    rdfs:label "FractureManagementPathway" ;
    kg:requires [ kg:capability kg:cap_AssessInjury ],
        [ kg:capability kg:cap_ManageRehab ],
        [ kg:capability kg:cap_InterpretXRay ],
        [ kg:capability kg:cap_AssessFracture ],
        [ kg:capability kg:cap_ConductFollowUp ],
        [ kg:capability kg:cap_PlanOrthopedicSurgery ] .

kg:task_MedicationReviewPathway a kg:TaskType ;
    rdfs:label "MedicationReviewPathway" ;
    kg:requires [ kg:capability kg:cap_CounselPatient ],
        [ kg:capability kg:cap_CheckDrugInteractions ],
        [ kg:capability kg:cap_ManageChronicCondition ],
        [ kg:capability kg:cap_ReconcileMedications ],
        [ kg:capability kg:cap_VerifyDosage ] .

kg:task_PediatricFeverWorkup a kg:TaskType ;
    rdfs:label "PediatricFeverWorkup" ;
    kg:requires [ kg:capability kg:cap_CoordinateReferral ],
        [ kg:capability kg:cap_AnalyzeSpecimen ],
        [ kg:capability kg:cap_AssessPatientCondition ],
        [ kg:capability kg:cap_RegisterPatient ],
        [ kg:capability kg:cap_ConductFollowUp ] .

kg:task_PostSurgicalFollowUpPathway a kg:TaskType ;
    rdfs:label "PostSurgicalFollowUpPathway" ;
    kg:requires [ kg:capability kg:cap_ManagePostOpCare ],
        [ kg:capability kg:cap_ConductFollowUp ],
        [ kg:capability kg:cap_ManageComplication ],
        [ kg:capability kg:cap_ManageRehab ] .

kg:task_PreOpClearancePathway a kg:TaskType ;
    rdfs:label "PreOpClearancePathway" ;
    kg:requires [ kg:capability kg:cap_CoordinateSurgery ],
        [ kg:capability kg:cap_CheckDrugInteractions ],
        [ kg:capability kg:cap_AssessPatientCondition ],
        [ kg:capability kg:cap_AssessSurgicalRisk ],
        [ kg:capability kg:cap_PlanSurgery ] .

kg:task_StrokeWorkup a kg:TaskType ;
    rdfs:label "StrokeWorkup" ;
    kg:requires [ kg:capability kg:cap_ConductFollowUp ],
        [ kg:capability kg:cap_AssessNeuroSymptoms ],
        [ kg:capability kg:cap_AssessStroke ],
        [ kg:capability kg:cap_PlanNeuroTreatment ],
        [ kg:capability kg:cap_AssessUrgency ] .

kg:task_TraumaResponsePathway a kg:TaskType ;
    rdfs:label "TraumaResponsePathway" ;
    kg:requires [ kg:capability kg:cap_PlanDischarge ],
        [ kg:capability kg:cap_AssessUrgency ],
        [ kg:capability kg:cap_CoordinateCriticalCare ],
        [ kg:capability kg:cap_InterpretCT ],
        [ kg:capability kg:cap_StabilizeTrauma ] .

