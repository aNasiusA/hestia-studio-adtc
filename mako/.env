# --- LLM backend (model-agnostic) -------------------------------------------
# Points at the local llama.cpp server (llama-server) running this
# submission's model — Qwen2.5-3B-Instruct GGUF Q4_K_M. Start it from the
# repo root first:
#   llama-server -m model/qwen2.5-3b-instruct-q4_k_m.gguf --port 8811 -t 4 -c 4096
KG_LLM_PROVIDER=openai
KG_MODEL=qwen2.5-3b-instruct-q4_k_m
KG_BASE_URL=http://localhost:8811/v1
KG_API_KEY=sk-local-llamacpp
KG_MAX_TOKENS=

# --- Provider-native keys (unused here — openai provider above reads KG_API_KEY) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Embeddings -- local hashing embedder, no model/network needed ----------
KG_EMBED_PROVIDER=local
KG_EMBED_MODEL=
KG_EMBED_DIM=
KG_EMBED_BASE_URL=
KG_EMBED_API_KEY=
KG_VECTOR_BACKEND=
