@prefix kg: <http://example.org/healthkg#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kg:Agent a rdfs:Class .

kg:Capability a rdfs:Class .

kg:ConsultHandoff a rdfs:Class ;
    rdfs:label "Consult" ;
    kg:isTerminal false ;
    rdfs:subClassOf kg:HandoffEdge .

kg:DelegationHandoff a rdfs:Class ;
    rdfs:label "Delegation" ;
    kg:isTerminal true ;
    rdfs:subClassOf kg:HandoffEdge .

kg:EscalationHandoff a rdfs:Class ;
    rdfs:label "Escalation" ;
    kg:isTerminal true ;
    rdfs:subClassOf kg:HandoffEdge .

kg:HandoffEdge a rdfs:Class .

kg:ReferralHandoff a rdfs:Class ;
    rdfs:label "Referral" ;
    kg:isTerminal true ;
    rdfs:subClassOf kg:HandoffEdge .

kg:ReturnHandoff a rdfs:Class ;
    rdfs:label "Return" ;
    kg:isTerminal true ;
    rdfs:subClassOf kg:HandoffEdge .

kg:TaskType a rdfs:Class .

kg:Tool a rdfs:Class .

kg:Cardiology_CathLabProcedure a kg:Agent ;
    rdfs:label "Cardiology CathLabProcedure" ;
    kg:handles kg:cap_PerformCatheterization ;
    kg:owns kg:tool_CathLabSystem ;
    kg:specialty "Cardiology" .

kg:Cardiology_StressTestAnalysis a kg:Agent ;
    rdfs:label "Cardiology StressTestAnalysis" ;
    kg:handles kg:cap_InterpretStressTest ;
    kg:owns kg:tool_StressTestSystem ;
    kg:specialty "Cardiology" .

kg:LabPathology_ResultReporting a kg:Agent ;
    rdfs:label "LabPathology ResultReporting" ;
    kg:handles kg:cap_ReportLabResults ;
    kg:owns kg:tool_EHRSystem,
        kg:tool_LabResultsAPI ;
    kg:specialty "LabPathology" .

kg:LabPathology_SpecimenIntake a kg:Agent ;
    rdfs:label "LabPathology SpecimenIntake" ;
    kg:handles kg:cap_ReceiveSpecimen ;
    kg:owns kg:tool_LabResultsAPI ;
    kg:specialty "LabPathology" .

kg:Neurology_EEGInterpretation a kg:Agent ;
    rdfs:label "Neurology EEGInterpretation" ;
    kg:handles kg:cap_InterpretEEG ;
    kg:owns kg:tool_EEGSystem ;
    kg:specialty "Neurology" .

kg:Neurology_NeuroExam a kg:Agent ;
    rdfs:label "Neurology NeuroExam" ;
    kg:handles kg:cap_ConductNeuroExam ;
    kg:owns kg:tool_EHRSystem ;
    kg:specialty "Neurology" .

kg:Oncology_RadiationPlanning a kg:Agent ;
    rdfs:label "Oncology RadiationPlanning" ;
    kg:handles kg:cap_PlanRadiationTherapy ;
    kg:owns kg:tool_RadiationPlanningSystem ;
    kg:specialty "Oncology" .

kg:Pediatrics_GrowthAssessment a kg:Agent ;
    rdfs:label "Pediatrics GrowthAssessment" ;
    kg:handles kg:cap_AssessGrowth ;
    kg:owns kg:tool_EHRSystem ;
    kg:specialty "Pediatrics" .

kg:Pediatrics_VaccinationManagement a kg:Agent ;
    rdfs:label "Pediatrics VaccinationManagement" ;
    kg:handles kg:cap_ManageVaccination ;
    kg:owns kg:tool_EHRSystem ;
    kg:specialty "Pediatrics" .

kg:Pharmacy_RefillManagement a kg:Agent ;
    rdfs:label "Pharmacy RefillManagement" ;
    kg:handles kg:cap_ManageRefill ;
    kg:owns kg:tool_EHRSystem ;
    kg:specialty "Pharmacy" .

kg:Radiology_IntakeOrder a kg:Agent ;
    rdfs:label "Radiology IntakeOrder" ;
    kg:handles kg:cap_ReceiveImagingOrder ;
    kg:owns kg:tool_EHRSystem ;
    kg:specialty "Radiology" .

kg:Radiology_MRIReading a kg:Agent ;
    rdfs:label "Radiology MRIReading" ;
    kg:handles kg:cap_InterpretMRI ;
    kg:owns kg:tool_ImagingViewer ;
    kg:specialty "Radiology" .

kg:Radiology_RadiologistConsult a kg:Agent ;
    rdfs:label "Radiology RadiologistConsult" ;
    kg:handles kg:cap_ProvideImagingOpinion ;
    kg:owns kg:tool_ImagingViewer ;
    kg:specialty "Radiology" .

kg:Radiology_ReportGeneration a kg:Agent ;
    rdfs:label "Radiology ReportGeneration" ;
    kg:handles kg:cap_GenerateRadiologyReport ;
    kg:owns kg:tool_EHRSystem ;
    kg:specialty "Radiology" .

kg:Radiology_UltrasoundReading a kg:Agent ;
    rdfs:label "Radiology UltrasoundReading" ;
    kg:handles kg:cap_InterpretUltrasound ;
    kg:owns kg:tool_ImagingViewer ;
    kg:specialty "Radiology" .

kg:consults a rdf:Property ;
    rdfs:comment "Request input or a second opinion from another agent for additional information, while the current agent keeps ownership of the case. Use when the current step needs supporting data before it can proceed, not when handing the case off for good." ;
    rdfs:subPropertyOf kg:canHandoffTo .

kg:delegatesTo a rdf:Property ;
    rdfs:comment "Hand the case forward to the next agent in the same care stage once the current step is complete. This is the ordinary forward progression of a clinical pathway (stage_complete), keeping the patient within the current line of care." ;
    rdfs:subPropertyOf kg:canHandoffTo .

kg:escalatesTo a rdf:Property ;
    rdfs:comment "Escalate to a higher-acuity or more specialised agent when an urgent finding or a condition exceeds the current agent's authority or scope. Use for time-critical or safety-critical transitions (urgent_finding)." ;
    rdfs:subPropertyOf kg:canHandoffTo .

